{
  "expo": {
    "name": "Les App",
    "slug": "les-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lesapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2F5BFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lesapp.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lesapp.app"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
