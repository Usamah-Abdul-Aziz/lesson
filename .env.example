# ============================================================================
# Salin file ini menjadi `.env` dan isi dengan kredensial Anda sendiri.
#   cp .env.example .env
#
# Dapatkan nilai ini di dashboard Supabase:
#   Project Settings -> API -> Project URL  -> EXPO_PUBLIC_SUPABASE_URL
#   Project Settings -> API -> API Keys    -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# Gemini API Key: https://aistudio.google.com/app/apikey
#   -> disimpan sebagai Supabase Secret (GEMINI_API_KEY), JANGAN taruh di sini.
# ============================================================================

# URL project Supabase Anda (wajib)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key Supabase — aman dipakai di aplikasi karena RLS aktif
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
